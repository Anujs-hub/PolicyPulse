# Copy to .env to override defaults. No secrets or API keys are required by PolicyPulse.
POLICYPULSE_ENVIRONMENT=development
POLICYPULSE_DATABASE_URL=sqlite:///./data/policypulse.db
# Comma-separated browser origins allowed by CORS ("*" is ignored on purpose).
POLICYPULSE_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
POLICYPULSE_MAX_REQUEST_BYTES=65536
POLICYPULSE_MAX_PAGE_SIZE=100
POLICYPULSE_EXPORT_MAX_ROWS=10000
POLICYPULSE_DASHBOARD_ACTIVITY_WINDOW=1000
